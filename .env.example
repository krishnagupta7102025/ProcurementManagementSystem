# MySQL. In production (AWS), point this at the RDS MySQL instance's
# endpoint — see docs/deploy-aws.md.
DATABASE_URL=mysql://p2p:p2p@localhost:3306/p2p

# S3-compatible object storage. Leave S3_ENDPOINT unset for real AWS S3.
# For Cloudflare R2 (a free-tier-friendly option — see
# docs/deploy-vercel.md): S3_REGION=auto, S3_ENDPOINT=
# https://<account-id>.r2.cloudflarestorage.com, and an R2 API token's
# access key/secret in the AWS_* vars below (R2's S3-compatible API takes
# the same SDK calls as real S3).
S3_BUCKET=p2p-dev
S3_REGION=ap-south-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# Signs/verifies local email+password login sessions (see src/auth/jwt.util.ts).
# Any long random string; rotating it invalidates every existing session.
# The API refuses to start without this set.
AUTH_JWT_SECRET=

# Comma-separated list of origins allowed to call this API (e.g. the
# frontend's real origin in production). Leave unset for local dev, where
# any origin is allowed.
CORS_ALLOWED_ORIGINS=

# Losung360 platform notification center
NOTIFICATION_CENTER_API_URL=

# Approval SLA escalation job (P2P-023) - reminder/escalate thresholds are
# optional, shown with defaults. Triggered by a scheduled GET request to
# /internal/cron/escalation-scan (see docs/deploy-aws.md — an EventBridge
# Scheduler rule on AWS) sending "Authorization: Bearer $CRON_SECRET",
# which is what the endpoint checks. Generate any long random string;
# required in production, optional locally (the endpoint just 401s
# without it).
APPROVAL_SLA_REMINDER_HOURS=48
APPROVAL_SLA_ESCALATE_HOURS=96
CRON_SECRET=

# Local testing only, until a real S3 bucket/credentials are configured (see
# src/storage/dev-local-storage.ts). Set to "local" to write/read generated
# documents (PO PDFs, etc.) on the local filesystem instead of S3 - NEVER in a
# deployed environment. main.ts refuses to boot if this is "local" and NODE_ENV is
# "production", as a second independent safety check.
STORAGE_DRIVER=
