# Postgres
DATABASE_URL=postgresql://p2p:p2p@localhost:5432/p2p?schema=public

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage
S3_BUCKET=p2p-dev
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# Losung360 Central Login (OIDC) - see docs/00-prd.md open questions.
# CENTRAL_LOGIN_ROLES_CLAIM / CENTRAL_LOGIN_ORG_CLAIM let you point at
# whatever claim names Central Login actually uses once confirmed with the
# platform team - see src/auth/oidc-auth.guard.ts.
CENTRAL_LOGIN_OIDC_ISSUER=
CENTRAL_LOGIN_CLIENT_ID=
CENTRAL_LOGIN_CLIENT_SECRET=
CENTRAL_LOGIN_ROLES_CLAIM=roles
CENTRAL_LOGIN_ORG_CLAIM=org_id
CENTRAL_LOGIN_NAME_CLAIM=name

# Losung360 platform notification center
NOTIFICATION_CENTER_API_URL=

# Approval SLA escalation job (P2P-023) - all optional, shown with defaults
APPROVAL_SLA_REMINDER_HOURS=48
APPROVAL_SLA_ESCALATE_HOURS=96
APPROVAL_SLA_CHECK_INTERVAL_MS=900000

# Local testing only, until Central Login is real (see src/auth/dev-auth-bypass.ts).
# Skips all real authentication - set to "true" only for local/dev use, NEVER in a
# deployed environment. main.ts refuses to boot if this is "true" and NODE_ENV is
# "production", as a second independent safety check.
DEV_AUTH_BYPASS=
