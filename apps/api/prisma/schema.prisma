// Losung360 Procure-to-Pay — Phase 0 foundation schema (P2P-002).
// See docs/00-prd.md for the full data model narrative.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A Losung360 tenant. Every other table is scoped by orgId — see
/// src/prisma/scoped-prisma.ts for the enforcement mechanism (P2P-002 AC).
model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  costCenters        CostCenter[]
  auditLogs          AuditLogEntry[]
  vendors            Vendor[]
  requisitions       Requisition[]
  approvalRules      ApprovalRule[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  invoices           Invoice[]
  matchExceptions    MatchException[]
  paymentBatches     PaymentBatch[]
  bankStatementLines BankStatementLine[]

  @@map("orgs")
}

enum Role {
  REQUESTER
  APPROVER
  BUYER
  RECEIVER
  AP
  CONTROLLER
  ADMIN
}

/// Mirrors identity from Losung360 Central Login (P2P-003) — this table is a
/// local cache of SSO users, not a source of truth for credentials.
model User {
  id             String   @id @default(cuid())
  orgId          String
  centralLoginId String   @unique
  email          String
  displayName    String
  roles          Role[]
  // Escalation target (P2P-023) once Central Login syncs a real org chart —
  // nullable, so an unmapped user simply never escalates rather than erroring.
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org                       Org                   @relation(fields: [orgId], references: [id])
  manager                   User?                 @relation("UserManager", fields: [managerId], references: [id])
  reports                   User[]                @relation("UserManager")
  requisitions              Requisition[]
  approvalRuleSteps         ApprovalRuleStep[]
  approvalSteps             ApprovalStep[]
  purchaseOrdersAsBuyer     PurchaseOrder[]
  goodsReceipts             GoodsReceipt[]
  serviceConfirmations      ServiceConfirmation[]
  invoicesCreated           Invoice[]
  matchExceptionsResolved   MatchException[]
  paymentBatchesCreated     PaymentBatch[]        @relation("PaymentBatchCreatedBy")
  paymentBatchesApproved    PaymentBatch[]        @relation("PaymentBatchApprovedBy")
  paymentBatchesReleased    PaymentBatch[]        @relation("PaymentBatchReleasedBy")
  bankStatementLinesMatched BankStatementLine[]

  @@unique([orgId, email])
  @@index([orgId])
  @@map("users")
}

model CostCenter {
  id         String   @id @default(cuid())
  orgId      String
  code       String
  name       String
  department String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org           Org            @relation(fields: [orgId], references: [id])
  requisitions  Requisition[]
  approvalRules ApprovalRule[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("cost_centers")
}

enum VendorStatus {
  ACTIVE
  ON_HOLD
  BLACKLISTED
}

/// Vendor master (P2P-010). No hard-delete endpoint — lifecycle is modeled
/// via status, consistent with the no-hard-delete convention for financial-
/// adjacent records in CLAUDE.md (a vendor may already be referenced by POs
/// once Epic D lands, so removing the row outright would break traceability).
model Vendor {
  id                String       @id @default(cuid())
  orgId             String
  legalName         String
  gstin             String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  paymentTermsDays  Int          @default(30)
  status            VendorStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  org            Org             @relation(fields: [orgId], references: [id])
  contacts       VendorContact[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@index([orgId])
  @@index([orgId, status])
  @@map("vendors")
}

model VendorContact {
  id       String  @id @default(cuid())
  orgId    String
  vendorId String
  name     String
  email    String?
  phone    String?

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([orgId])
  @@index([vendorId])
  @@map("vendor_contacts")
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  WITHDRAWN
}

/// Purchase Requisition (P2P-020). Money is integer minor units + ISO
/// currency per CLAUDE.md convention. Editable only in DRAFT — submitting
/// snapshots an approval chain onto ApprovalStep and the requisition itself
/// becomes read-only until withdrawn or acted on by an approver.
model Requisition {
  id                       String            @id @default(cuid())
  orgId                    String
  requesterId              String
  costCenterId             String
  department               String
  neededByDate             DateTime?
  justification            String?
  status                   RequisitionStatus @default(DRAFT)
  estimatedTotalMinorUnits Int               @default(0)
  currency                 String            @default("INR")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  org           Org                     @relation(fields: [orgId], references: [id])
  requester     User                    @relation(fields: [requesterId], references: [id])
  costCenter    CostCenter              @relation(fields: [costCenterId], references: [id])
  lines         RequisitionLine[]
  attachments   RequisitionAttachment[]
  approvalSteps ApprovalStep[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, requesterId])
  @@map("requisitions")
}

model RequisitionLine {
  id                           String @id @default(cuid())
  orgId                        String
  requisitionId                String
  description                  String
  quantity                     Int
  unit                         String
  estimatedUnitPriceMinorUnits Int

  requisition Requisition             @relation(fields: [requisitionId], references: [id])
  poLineLinks POLineRequisitionLine[]

  @@index([orgId])
  @@index([requisitionId])
  @@map("requisition_lines")
}

/// Quotes/spec sheets attached to a requisition, stored in S3 under the
/// org-scoped key prefix enforced by StorageService (P2P-005).
model RequisitionAttachment {
  id            String   @id @default(cuid())
  orgId         String
  requisitionId String
  s3Key         String
  fileName      String
  createdAt     DateTime @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id])

  @@index([orgId])
  @@index([requisitionId])
  @@map("requisition_attachments")
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

/// Purchase Order (P2P-030). A PO's lines always trace back to at least
/// one RequisitionLine via POLineRequisitionLine — see that model. Money
/// is integer minor units per CLAUDE.md convention.
model PurchaseOrder {
  id                        String    @id @default(cuid())
  orgId                     String
  vendorId                  String
  buyerId                   String
  status                    POStatus  @default(DRAFT)
  negotiatedTotalMinorUnits Int       @default(0)
  currency                  String    @default("INR")
  deliveryDate              DateTime?
  billToAddress             String?
  shipToAddress             String?
  pdfS3Key                  String?
  sentToVendorAt            DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  org           Org            @relation(fields: [orgId], references: [id])
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  buyer         User           @relation(fields: [buyerId], references: [id])
  lines         POLine[]
  goodsReceipts GoodsReceipt[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, vendorId])
  @@map("purchase_orders")
}

model POLine {
  id                  String  @id @default(cuid())
  orgId               String
  purchaseOrderId     String
  description         String
  quantity            Int
  unit                String
  unitPriceMinorUnits Int
  // Service lines are closed out via ServiceConfirmation instead of a
  // physical GRN (P2P-041) — set at PO creation, immutable thereafter.
  isService           Boolean @default(false)

  purchaseOrder       PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  requisitionAllocs   POLineRequisitionLine[]
  grnLines            GRNLine[]
  serviceConfirmation ServiceConfirmation?
  invoiceLines        InvoiceLine[]

  @@index([orgId])
  @@index([purchaseOrderId])
  @@map("po_lines")
}

/// Junction recording exactly how much of a RequisitionLine's quantity a
/// given POLine draws on — this is what makes both "split one requisition
/// across multiple vendor POs" and "consolidate multiple requisitions into
/// one PO" possible, and what P2P-030's AC checks against: the sum of a
/// RequisitionLine's allocations across every PO must not exceed its own
/// quantity, unless overridden (RequisitionService... actually enforced in
/// PurchaseOrderService.create()).
model POLineRequisitionLine {
  id                String @id @default(cuid())
  orgId             String
  poLineId          String
  requisitionLineId String
  quantity          Int

  poLine          POLine          @relation(fields: [poLineId], references: [id])
  requisitionLine RequisitionLine @relation(fields: [requisitionLineId], references: [id])

  @@index([orgId])
  @@index([poLineId])
  @@index([requisitionLineId])
  @@map("po_line_requisition_lines")
}

/// One receiving event against an issued PO (P2P-040) — a PO can have many,
/// covering partial deliveries. Physical-goods lines only; service lines
/// use ServiceConfirmation instead.
model GoodsReceipt {
  id              String   @id @default(cuid())
  orgId           String
  purchaseOrderId String
  receivedById    String
  receivedDate    DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  org           Org           @relation(fields: [orgId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User          @relation(fields: [receivedById], references: [id])
  lines         GRNLine[]

  @@index([orgId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GRNLine {
  id               String  @id @default(cuid())
  orgId            String
  goodsReceiptId   String
  poLineId         String
  quantityReceived Int
  conditionNotes   String?
  // Set only when this line's cumulative received quantity exceeds the PO
  // line's ordered quantity beyond tolerance and a Buyer explicitly
  // overrode the block (P2P-040 AC) — null on every normal-quantity line.
  overrideReason   String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  poLine       POLine       @relation(fields: [poLineId], references: [id])

  @@index([orgId])
  @@index([goodsReceiptId])
  @@index([poLineId])
  @@map("grn_lines")
}

/// Closes out a service PO line (P2P-041) — a designated approver confirms
/// the service was delivered, in place of a quantity-based GRN. One
/// confirmation per line: a service is either done or it isn't.
model ServiceConfirmation {
  id            String   @id @default(cuid())
  orgId         String
  poLineId      String   @unique
  confirmedById String
  confirmedAt   DateTime @default(now())
  notes         String?

  poLine      POLine @relation(fields: [poLineId], references: [id])
  confirmedBy User   @relation(fields: [confirmedById], references: [id])

  @@index([orgId])
  @@map("service_confirmations")
}

/// Configurable approval policy (P2P-021): matches on department/cost
/// center/amount band, resolving to an ordered approver list. A null
/// department or costCenterId is a wildcard (matches any). Editing a rule
/// never touches ApprovalStep rows already snapshotted for in-flight
/// requisitions — see ApprovalStep below.
model ApprovalRule {
  id                  String   @id @default(cuid())
  orgId               String
  name                String
  department          String?
  costCenterId        String?
  minAmountMinorUnits Int      @default(0)
  maxAmountMinorUnits Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org        Org                @relation(fields: [orgId], references: [id])
  costCenter CostCenter?        @relation(fields: [costCenterId], references: [id])
  steps      ApprovalRuleStep[]

  @@index([orgId])
  @@map("approval_rules")
}

model ApprovalRuleStep {
  id             String @id @default(cuid())
  orgId          String
  approvalRuleId String
  stepOrder      Int
  approverUserId String

  approvalRule ApprovalRule @relation(fields: [approvalRuleId], references: [id])
  approver     User         @relation(fields: [approverUserId], references: [id])

  @@unique([approvalRuleId, stepOrder])
  @@index([orgId])
  @@map("approval_rule_steps")
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// A concretized, immutable-once-created snapshot of one requisition's
/// approval chain, resolved from ApprovalRule at submit time (P2P-021 AC:
/// changing a rule later never retroactively alters an in-flight chain).
/// becameActiveAt/reminderSentAt/escalatedAt drive the idempotent SLA
/// escalation job (P2P-023) — each fires at most once per step.
model ApprovalStep {
  id             String             @id @default(cuid())
  orgId          String
  requisitionId  String
  stepOrder      Int
  approverUserId String
  status         ApprovalStepStatus @default(PENDING)
  reason         String?
  becameActiveAt DateTime?
  reminderSentAt DateTime?
  escalatedAt    DateTime?
  actedAt        DateTime?
  createdAt      DateTime           @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id])
  approver    User        @relation(fields: [approverUserId], references: [id])

  @@unique([requisitionId, stepOrder])
  @@index([orgId])
  @@index([orgId, approverUserId, status])
  @@map("approval_steps")
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  MATCHED
  MATCH_EXCEPTION
  APPROVED_FOR_PAYMENT
  PAID
  VOID
}

/// Vendor invoice (P2P-050). Every line points at the specific POLine it
/// bills against — that FK chain is what "links to one or more POs" means
/// in practice (a multi-PO invoice just has lines pointing at different
/// POs' lines), so there's no separate invoice<->PO junction table.
/// ocrExtractedData is a Phase 1 stub: schema is ready, nothing writes to
/// it yet (see docs/10-phase-0-tickets.md P2P-050).
model Invoice {
  id                   String        @id @default(cuid())
  orgId                String
  vendorId             String
  invoiceNumber        String
  invoiceDate          DateTime
  dueDate              DateTime?
  currency             String        @default("INR")
  subtotalMinorUnits   Int           @default(0)
  taxMinorUnits        Int           @default(0)
  totalMinorUnits      Int           @default(0)
  // Incremented as PaymentBatches covering this invoice are released
  // (P2P-062) — status becomes PAID once this reaches totalMinorUnits;
  // partial payments leave it at APPROVED_FOR_PAYMENT.
  paidAmountMinorUnits Int           @default(0)
  status               InvoiceStatus @default(DRAFT)
  ocrExtractedData     Json?
  fileS3Key            String?
  createdById          String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  org               Org                @relation(fields: [orgId], references: [id])
  vendor            Vendor             @relation(fields: [vendorId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  lines             InvoiceLine[]
  matchExceptions   MatchException[]
  paymentBatchLines PaymentBatchLine[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, vendorId, invoiceNumber])
  @@map("invoices")
}

model InvoiceLine {
  id                  String @id @default(cuid())
  orgId               String
  invoiceId           String
  poLineId            String
  description         String
  quantity            Int
  unitPriceMinorUnits Int

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  poLine  POLine  @relation(fields: [poLineId], references: [id])

  @@index([orgId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

enum MatchExceptionStatus {
  OPEN
  RESOLVED
}

/// The diff produced when an invoice line fails 2-way/3-way match (P2P-052)
/// and the resolution trail for it (P2P-053). One row per matching attempt
/// that found a problem — re-matching after an adjustment creates a fresh
/// row rather than mutating history away.
model MatchException {
  id               String               @id @default(cuid())
  orgId            String
  invoiceId        String
  status           MatchExceptionStatus @default(OPEN)
  diff             Json
  resolutionAction String?
  resolutionNotes  String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())

  org        Org     @relation(fields: [orgId], references: [id])
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  resolvedBy User?   @relation(fields: [resolvedById], references: [id])

  @@index([orgId])
  @@index([orgId, status])
  @@map("match_exceptions")
}

enum PaymentBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RELEASED
  CANCELLED
}

/// A payment run (P2P-060): groups one or more APPROVED_FOR_PAYMENT
/// invoices with the amount to pay against each (PaymentBatchLine),
/// supporting both partial payment of a single invoice and one release
/// covering several. Batches above PAYMENT_BATCH_APPROVAL_THRESHOLD need a
/// Controller/Admin approval before they can be released (P2P-061) —
/// release() re-checks that independently of status, per its AC.
model PaymentBatch {
  id                    String             @id @default(cuid())
  orgId                 String
  status                PaymentBatchStatus @default(DRAFT)
  totalAmountMinorUnits Int                @default(0)
  currency              String             @default("INR")
  method                String?
  referenceNumber       String?
  paymentDate           DateTime?
  createdById           String
  approvedById          String?
  approvedAt            DateTime?
  releasedById          String?
  releasedAt            DateTime?
  clearedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  org                Org                 @relation(fields: [orgId], references: [id])
  createdBy          User                @relation("PaymentBatchCreatedBy", fields: [createdById], references: [id])
  approvedBy         User?               @relation("PaymentBatchApprovedBy", fields: [approvedById], references: [id])
  releasedBy         User?               @relation("PaymentBatchReleasedBy", fields: [releasedById], references: [id])
  lines              PaymentBatchLine[]
  bankStatementLines BankStatementLine[]

  @@index([orgId])
  @@index([orgId, status])
  @@map("payment_batches")
}

model PaymentBatchLine {
  id               String @id @default(cuid())
  orgId            String
  paymentBatchId   String
  invoiceId        String
  amountMinorUnits Int

  paymentBatch PaymentBatch @relation(fields: [paymentBatchId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])

  @@index([orgId])
  @@index([paymentBatchId])
  @@index([invoiceId])
  @@map("payment_batch_lines")
}

/// One imported bank statement row (P2P-063), manually reconciled against
/// a released PaymentBatch — matching sets the batch's clearedAt.
model BankStatementLine {
  id                    String    @id @default(cuid())
  orgId                 String
  transactionDate       DateTime
  description           String
  amountMinorUnits      Int
  reference             String?
  matchedPaymentBatchId String?
  matchedById           String?
  matchedAt             DateTime?
  createdAt             DateTime  @default(now())

  org                 Org           @relation(fields: [orgId], references: [id])
  matchedPaymentBatch PaymentBatch? @relation(fields: [matchedPaymentBatchId], references: [id])
  matchedBy           User?         @relation(fields: [matchedById], references: [id])

  @@index([orgId])
  @@index([orgId, matchedPaymentBatchId])
  @@map("bank_statement_lines")
}

/// Append-only, polymorphic audit trail (P2P-004). Never updated or deleted —
/// only inserted via AuditService.record().
model AuditLogEntry {
  id         String   @id @default(cuid())
  orgId      String
  entityType String
  entityId   String
  action     String
  actorId    String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id])

  @@index([orgId, entityType, entityId])
  @@map("audit_log_entries")
}
